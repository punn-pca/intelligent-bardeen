# DeepSeek Cloud API (primary AI provider)
# Get your API key from the DeepSeek platform.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

